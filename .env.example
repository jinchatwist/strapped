# Anthropic API key (get one at https://console.anthropic.com)
# Only used to look up watches that aren't in the catalog.
ANTHROPIC_API_KEY=

# Try-on picture. Set ONE of these (first one set wins):
# 1) Google Cloud API key with the Vertex AI API enabled. Billed to Google Cloud, so trial credits apply.
GOOGLE_CLOUD_API_KEY=
# 2) Vertex AI with a service account: project id + the service account key JSON on one line.
GOOGLE_CLOUD_PROJECT=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CLOUD_LOCATION=global
# 3) Google AI Studio key (https://aistudio.google.com/apikey). Billed by AI Studio, trial credits don't apply.
GEMINI_API_KEY=

# Beta test
# Free try-ons per person (default 5) and the most try-ons for everyone in one day (default 60, about $4).
FREE_TRYONS=5
DAILY_TRYON_CAP=60
# Password for the /admin numbers page.
ADMIN_KEY=
# Optional: testers who open the app with ?code=<this> get unlimited try-ons (for Jin and friends).
TESTER_CODE=
# Shared store for limits, numbers and feedback. Vercel → Storage → Upstash Redis fills these in.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: stop try-ons once this many dollars of AI pictures have been made (set it to what you've put into AI Studio).
AI_BUDGET_USD=
