# Anthropic API key (get one at https://console.anthropic.com)
# Without it, fit checks return demo notes and lookups are off.
ANTHROPIC_API_KEY=

# Try-on picture. Set ONE of these (first one set wins):
# 1) Google Cloud API key with the Vertex AI API enabled. Billed to Google Cloud, so trial credits apply.
GOOGLE_CLOUD_API_KEY=
# 2) Vertex AI with a service account: project id + the service account key JSON on one line.
GOOGLE_CLOUD_PROJECT=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CLOUD_LOCATION=global
# 3) Google AI Studio key (https://aistudio.google.com/apikey). Billed by AI Studio, trial credits don't apply.
GEMINI_API_KEY=
